{
  "// note": "OreFlow editor defaults: point Pylance at the project venv + pipeline source, and keep file watching off virtualenvs and generated data so the editor stays responsive.",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["data-pipeline"],
  "python.analysis.exclude": ["**/.venv*/**", "**/node_modules/**", "**/frontend/dist/**"],
  "files.watcherExclude": {
    "**/.venv*/**": true,
    "**/node_modules/**": true,
    "**/frontend/dist/**": true,
    "**/frontend/public/data/**": true,
    "**/__pycache__/**": true,
    "**/data/raw/**": true
  },
  "search.exclude": {
    "**/.venv*": true,
    "**/node_modules": true,
    "**/frontend/dist": true
  }
}
