# The OreFlow service's settings (app/config.py), with their defaults. The service reads them from the process
# environment; it never loads this file. For a local run, export the ones you change in your shell before starting
# uvicorn (PowerShell: $env:APP_PORT = "8146"); on the VPS the systemd unit sets them (deploy/oreflow.service).
# Nothing here is a secret, and the workbench itself needs none of them.

# dev allows the Vite dev server's origins (DEV_ORIGINS); prod allows the public site's (PROD_ORIGINS)
APP_ENV=dev
# the address and port uvicorn serves on
APP_HOST=127.0.0.1
APP_PORT=8146
# the committed records the API serves, relative to the repository root
DATA_DIR=data/derived
# comma-separated browser origins allowed by CORS in each mode
DEV_ORIGINS=http://127.0.0.1:5914,http://localhost:5914
PROD_ORIGINS=https://oreflow.ml.fasl-work.com

# Offline measured-source acquisition/training only. Required unless an existing
# --source file is supplied; no default and no automatic .env loading by wrappers.
# Set to the device's external data root: cache layout <root>/oreflow/raw/.
# PowerShell: $env:CAOS_DATA_ROOT = '<external data root>'
# Bash: export CAOS_DATA_ROOT='<external data root>'
CAOS_DATA_ROOT=
# Required for local checkpoint fitting/inference and particle training unless an
# external --checkpoint file is supplied. Layout <root>/oreflow/; never a checkout.
CAOS_MODELS_ROOT=
# Optional external scratch root for test/notebook runners; not needed by dev.
CAOS_TEMP_ROOT=
# scripts/dev.ps1 and scripts/dev.sh need only Node/npm and shipped artifacts.
# They install dependencies when absent or when their SHA256 lock stamp is missing/stale,
# stamp node_modules only after npm ci succeeds, then npm run dev.
# No data-root configuration, source downloads or training are part of dev launch.
