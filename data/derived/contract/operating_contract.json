   "high": 1.5,
   "step": 0.01,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "magnetic",
    "deslime_rougher"
   ],
   "label": {
    "en": "Ore throughput",
    "es": "Tratamiento de mineral"
   },
   "help": {
    "en": "Dry ore fed to the grinding circuit. More tonnes shorten flotation residence and, once the mill runs at installed power, coarsen the grind.",
    "es": "Mineral seco alimentado al circuito de molienda. Más toneladas acortan la residencia en flotación y, cuando el molino llega a su potencia instalada, engruesan la molienda."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "target_p80_um",
   "unit": "um",
   "bounds": "relative",
   "low": 0.5,
   "high": 2.0,
   "step": 0.01,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "magnetic",
    "deslime_rougher"
   ],
   "label": {
    "en": "Grind target (P80)",
    "es": "Objetivo de molienda (P80)"
   },
   "help": {
    "en": "Size that 80% of the cyclone overflow passes. The solver finds the mill energy that meets it; a finer target needs more energy and liberates more of the valuable mineral.",
    "es": "Tamaño bajo el cual pasa el 80% del rebose del ciclón. El solver busca la energía de molienda que lo cumple; un objetivo más fino requiere más energía y libera más mineral valioso."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "circulating_load",
   "unit": "1",
   "bounds": "absolute",
   "low": 1.0,
   "high": 4.0,
   "step": 0.05,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "magnetic",
    "deslime_rougher"
   ],
   "label": {
    "en": "Circulating load",
    "es": "Carga circulante"
   },
   "help": {
    "en": "Cyclone underflow returned to the mill per tonne of new feed. The cyclone cut is solved to hold it; a higher load lowers the grinding energy for the same target, with diminishing returns.",
    "es": "Descarga del ciclón que vuelve al molino por tonelada de alimentación fresca. El corte del ciclón se resuelve para sostenerla; una carga mayor reduce la energía de molienda para el mismo objetivo, con retornos decrecientes."
   },
   "display_scale": 100.0,
   "display_unit": "%"
  },
  {
   "name": "water_m3_t",
   "unit": "m3/t",
   "bounds": "absolute",
   "low": 1.0,
   "high": 4.0,
   "step": 0.05,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "magnetic",
    "deslime_rougher"
   ],
   "label": {
    "en": "Overflow water",
    "es": "Agua en el rebose"
   },
   "help": {
    "en": "Water leaving with the cyclone overflow per tonne of ore. It sets the separation feed density and the pulp volume in the cells, so more water shortens residence time.",
    "es": "Agua que sale con el rebose del ciclón por tonelada de mineral. Fija la densidad de la alimentación a separación y el volumen de pulpa en las celdas, por lo que más agua acorta la residencia."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "crusher_css_mm",
   "unit": "mm",
   "bounds": "absolute",
   "low": 4.0,
   "high": 16.0,
   "step": 0.5,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "magnetic",
    "deslime_rougher"
   ],
   "label": {
    "en": "Crusher closed-side setting",
    "es": "Abertura de descarga del chancador"
   },
   "help": {
    "en": "Closed-side setting of the crusher ahead of the mill. A tighter setting makes a finer mill feed and moves reduction work from the mill to the crusher.",
    "es": "Abertura de descarga del chancador antes del molino. Una abertura menor produce una alimentación más fina al molino y traslada trabajo de reducción del molino al chancador."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "work_index_kwh_t",
   "unit": "kWh/t",
   "bounds": "relative",
   "low": 0.7,
   "high": 1.5,
   "step": 0.01,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "magnetic",
    "deslime_rougher"
   ],
   "label": {
    "en": "Bond work index",
    "es": "Índice de trabajo de Bond"
   },
   "help": {
    "en": "Ball-mill work index of the ore. Harder ore breaks more slowly per kWh, so it needs more energy for the same target, or coarsens the grind when the mill is at installed power.",
    "es": "Índice de trabajo de molino de bolas del mineral. Un mineral más duro se fractura más lento por kWh, por lo que requiere más energía para el mismo objetivo, o engruesa la molienda con el molino a potencia instalada."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "head_grade",
   "unit": "case",
   "bounds": "relative",
   "low": 0.5,
   "high": 1.5,
   "step": 0.01,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "magnetic",
    "deslime_rougher"
   ],
   "label": {
    "en": "Head grade",
    "es": "Ley de cabeza"
   },
   "help": {
    "en": "Grade of the primary payable in the fresh ore. It sets the valuable-mineral content through the mineral's stoichiometry; the host gangue closes the mass balance.",
    "es": "Ley del elemento pagable principal en el mineral fresco. Fija el contenido de mineral valioso a través de su estequiometría; la ganga huésped cierra el balance de masa."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "collector_gpt",
   "unit": "g/t",
   "bounds": "relative",
   "low": 0.0,
   "high": 3.0,
   "step": 0.01,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "deslime_rougher"
   ],
   "label": {
    "en": "Collector dose",
    "es": "Dosis de colector"
   },
   "help": {
    "en": "Collector added per tonne of ore. Valuable minerals respond at a lower dose than gangue, so more collector raises recovery at first and then lowers the concentrate grade.",
    "es": "Colector agregado por tonelada de mineral. Los minerales valiosos responden a menor dosis que la ganga, por lo que más colector sube primero la recuperación y luego baja la ley del concentrado."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "jg_cm_s",
   "unit": "cm/s",
   "bounds": "absolute",
   "low": 0.5,
   "high": 2.5,
   "step": 0.05,
   "integer": false,
   "families": [
    "rougher",
    "gravity_rougher",
    "deslime_rougher"
   ],
   "label": {
    "en": "Gas velocity (rougher)",
    "es": "Velocidad de gas (rougher)"
   },
   "help": {
    "en": "Superficial gas velocity in the rougher cells. It sets the bubble surface area flux and so the rate constants, and it raises water recovery and the entrainment of fine gangue.",
    "es": "Velocidad superficial de gas en las celdas rougher. Fija el flujo de área superficial de burbujas y por tanto las constantes cinéticas, y aumenta la recuperación de agua y el arrastre de ganga fina."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "rougher_cells",
   "unit": "1",
   "bounds": "absolute",
   "low": 3,
   "high": 12,
   "step": 1,
   "integer": true,
   "families": [
    "rougher",
    "gravity_rougher",
    "deslime_rougher"
   ],
   "label": {
    "en": "Rougher cells",
    "es": "Celdas rougher"
   },
   "help": {
    "en": "Number of rougher cells in series. More cells add residence time and approach plug flow, so recovery rises with diminishing returns.",
    "es": "Número de celdas rougher en serie. Más celdas agregan residencia y se acercan al flujo pistón, por lo que la recuperación sube con retornos decrecientes."
   },
   "display_scale": 1.0,
   "display_unit": ""
  },
  {
   "name": "gravity_bleed",
   "unit": "1",
   "bounds": "absolute",
   "low": 0.1,
   "high": 0.6,
   "step": 0.01,
   "integer": false,
   "families": [
    "gravity_rougher"
   ],
   "label": {
    "en": "Gravity bleed",
    "es": "Purga gravimétrica"
   },
   "help": {
    "en": "Fraction of the cyclone underflow sent to the gravity concentrator. Free gold circulates many times, so a modest bleed recovers much of it, with diminishing returns.",
    "es": "Fracción de la descarga del ciclón enviada al concentrador gravimétrico. El oro libre circula muchas veces, por lo que una purga moderada recupera gran parte, con retornos decrecientes."
   },
   "display_scale": 100.0,
   "display_unit": "%"
  },
  {
   "name": "deslime_cut_um",
   "unit": "um",
   "bounds": "absolute",
   "low": 8.0,
   "high": 45.0,
   "step": 0.5,
   "integer": false,
   "families": [
    "deslime_rougher"
   ],
   "label": {
    "en": "Desliming cut",
    "es": "Corte de deslamado"
   },
   "help": {
    "en": "Cut size of the desliming cyclone. Finer particles go to tailings as slimes: a coarser cut cleans the flotation feed and loses more of the fine valuable mineral.",
    "es": "Tamaño de corte del ciclón de deslamado. Las partículas más finas van a relaves como lamas: un corte más grueso limpia la alimentación a flotación y pierde más mineral valioso fino."
   },
   "display_scale": 1.0,
   "display_unit": ""
  }
 ],
 "rules": [
  {
   "id": "deslime_cut_above_half_target",
