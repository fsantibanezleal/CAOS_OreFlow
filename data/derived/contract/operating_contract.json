   "right": "target_p80_um",
   "message": {
    "en": "The desliming cut must be at most half the grind target; a coarser cut discards the product.",
    "es": "El corte de deslamado debe ser a lo más la mitad del objetivo de molienda; un corte más grueso descarta el producto."
   }
  }
