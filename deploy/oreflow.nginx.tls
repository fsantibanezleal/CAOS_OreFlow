server {
    listen 80;
    listen [::]:80;
    server_name oreflow.ml.fasl-work.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name oreflow.ml.fasl-work.com;

    ssl_certificate /etc/letsencrypt/live/oreflow.ml.fasl-work.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/oreflow.ml.fasl-work.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 4m;
    location / {
        proxy_pass http://127.0.0.1:8146;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
